# ==========================================
# CONFIGURACIÓN GENERAL / BASE DE DATOS
# ==========================================
DB_HOST=
DB_PORT=
DB_NAME=telemetria

# Usuario general / Solo lectura (usado por API y ML)
DB_USER=nombre
DB_PASS=Clave

# Usuario con permisos de escritura (para Machine Learning)
DB_W_USER=nombre
DB_W_PASS=Clave

# URL de la base de datos
DATABASE_URL=mysql+pymysql://nombre:Clave@127.0.0.1:3307/telemetria

# ==========================================
# TELEGRAM / ALERTAS
# ==========================================
TELEGRAM_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui
TELEGRAM_CHANNEL_ID=@nombre
ALLOWED_IDS=
DB_TABLE=lecturas_raw
DB_COL_FECHA=timestamp
DB_COL_NODO=nodo_id
NODO_ID=N01
DB_TZ=UTC
TIMEZONE=America/Santiago
REPORTE_DIARIO_HORA=08:00
REPORTE_SEMANAL_HORA=08:00
REPORTE_SEMANAL_DIA=1
ALERT_INTERVAL_S=60
ALERT_WINDOW_MIN=5
ALERT_COOLDOWN_MIN=30

# ==========================================
# API Y CONFIGURACIÓN WEB
# ==========================================
NODO_DEFECTO=N01
ADMIN_PASSWORD=clave
TOKEN_SECRET=token
CORS_ORIGINS=http://localhost:5173

# ==========================================
# INFRAESTRUCTURA / HARDWARE / GRAFANA
# ==========================================
